{
  "name": "a 重置日历授权 → 问日程 → 批准 → 系统授权框点允许 → 续做出结果（真机，--dev）",
  "model": "MiMo v2.6 Flash",
  "steps": [
    { "do": "quit" },
    { "do": "reset-tcc", "service": "Calendar" },
    { "do": "launch" },
    { "do": "reload" },
    { "do": "new-session" },
    { "do": "send", "text": "我今天有哪些日程？" },
    { "do": "wait-idle", "expect": "needs-user" },
    { "do": "click", "target": "role=button:/^允许一次/" },
    { "do": "ax-click", "name": "Allow Full Access", "process": "UserNotificationCenter", "timeout": 30000 },
    { "do": "wait-idle", "expect": "idle", "grace": 15000 },
    { "do": "wait-log", "pattern": "Agent run completed" },
    { "do": "assert-visible", "target": "testid=turn-reply-actions", "within": 3000 },
    { "do": "shot", "name": "a-final" }
  ]
}
