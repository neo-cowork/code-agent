  "englishState": [
    "\\baccepted\\s*[：:]\\s*",
    "\\[(running|completed|failed|cancelled|canceled|pending)\\]\\s*id=([A-Za-z0-9_-]+)",
    "\\binterrupted:\\s*process crashed\\b",
    "\\btool call was cancelled\\b",
    "\\bresult was recorded\\b",
