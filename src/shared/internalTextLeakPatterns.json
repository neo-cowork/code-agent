  "ouId": "\\b(?:ou_[A-Za-z0-9_-]{3,}|oc_[A-Za-z0-9_-]{3,})\\b",
  "internalToolPrefix": "(?<![A-Za-z0-9_/-])mcp__[A-Za-z0-9_-]+(?:__[A-Za-z0-9_-]+)*(?![A-Za-z0-9_/-])",
  "internalToolNames": [
    "read_file",
